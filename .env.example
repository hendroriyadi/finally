# FinAlly environment. Copy to `.env` (the start script does this for you).
#
# Parsed by Docker's --env-file, NOT by a shell: values must be unquoted
# (quotes would become part of the value), and comments must be on their own
# lines rather than trailing a value.

# Enables the AI copilot. Without it, chat still works but every reply falls
# back to the graceful "I had trouble processing that" message.
OPENROUTER_API_KEY=

# Optional. Empty means the built-in market simulator runs, which is the
# recommended setup and needs no account.
MASSIVE_API_KEY=

# Deterministic offline chat replies for the E2E suite. Leave false for
# normal use.
LLM_MOCK=false
