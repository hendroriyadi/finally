# Copy to .env and fill in. Only OPENROUTER_API_KEY is required.

# Required: OpenRouter API key, used for the AI chat assistant
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (E2E tests, no API key needed)
LLM_MOCK=false
